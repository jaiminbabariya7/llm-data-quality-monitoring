# GCP
GCP_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
BIGQUERY_DATASET=ecommerce

# OpenAI (optional: without a key, a rule-based summary is used)
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# Where previous table profiles are stored (baseline for drift / schema checks)
PROFILE_STORE_DIR=profiles

# Slack (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Email alerts (optional)
ALERT_EMAIL_TO=data-team@yourcompany.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@yourcompany.com
SMTP_PASSWORD=your-app-password
